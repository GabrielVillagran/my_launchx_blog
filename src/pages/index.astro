---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { experience } from '../lib/experience';
import { projects } from '../lib/projects';
import { urlFor, publicationDate } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).slice(0, 3);
---
<BaseLayout title="Home" description="Gabriel Villagrán is a software engineer with experience in iOS, backend integrations, and industrial monitoring. Explore his work and writing.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="eyebrow">Gabriel Villagrán / Software Engineer</span>
      <h1 id="hero-title">I build things<br />that <em>hold together.</em></h1>
      <p class="lede">I’m Gabriel. I work across iOS, backend integrations, and the web, turning complex workflows into software people can rely on. I write about the ideas I learn along the way.</p>
      <div class="hero-actions"><a class="button-primary" href={urlFor('work/')}>Explore my experience <span aria-hidden="true">↗</span></a><a class="text-link" href={urlFor('about/')}>More about me <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-art">
      <img src={urlFor('images/gabriel-profile.webp')} alt="Gabriel standing in front of the Golden Gate Bridge" width="964" height="868" fetchpriority="high" />
    </div>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow">01 / Experience</span><h2 id="work-title">Built in the real world.</h2><p>From industrial monitoring to mobile commerce and backend integrations.</p></div><a class="text-link" href={urlFor('work/')}>All experience <span aria-hidden="true">↗</span></a></div>
    <div class="work-grid">{experience.map((position) => <WorkCard position={position} />)}</div>
  </section>

  <section class="section writing-band" aria-labelledby="writing-title">
    <div class="section-heading"><div><span class="eyebrow">02 / Writing</span><h2 id="writing-title">Notes from the journey.</h2><p>Early ideas, revisited with what I know now.</p></div><a class="text-link" href={urlFor('blog/')}>All articles <span aria-hidden="true">↗</span></a></div>
    <div class="post-list">
      {posts.map((post) => <article class="post-row">
        <time datetime={post.data.published.toISOString()}>{publicationDate(post.data.published)}</time>
        <div><h3><a href={urlFor(`blog/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
        <span class="post-meta">{post.data.category} · {post.data.readingMinutes} min</span>
      </article>)}
    </div>
  </section>

  <section class="section projects-section" aria-labelledby="projects-title">
    <div class="section-heading"><div><span class="eyebrow">03 / Personal projects</span><h2 id="projects-title">The workshop.</h2><p>Things I’m making outside of work.</p></div><a class="text-link" href={urlFor('projects/')}>All projects <span aria-hidden="true">↗</span></a></div>
    {projects.map((project) => <article class="project-teaser">
      <div class="project-teaser-mark" aria-label="Project image coming soon"><span aria-hidden="true">◇</span><small>Image coming soon</small></div>
      <div><span class="status-pill">{project.status}</span><h3>{project.name}</h3><p>{project.description}</p><div class="card-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div>
      <a class="text-link" href={urlFor('projects/')}>See project <span aria-hidden="true">↗</span></a>
    </article>)}
  </section>
</BaseLayout>
