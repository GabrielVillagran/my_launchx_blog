---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { projects } from '../lib/projects';
import { urlFor, publicationDate } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).slice(0, 3);
---
<BaseLayout title="Home" description="Gabriel Villagrán is a software engineer working across backend, frontend, and iOS. Read about his projects and technical writing.">
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <span class="eyebrow">Software engineer · Writer · Builder</span>
      <h1 id="hero-title">Building systems. <em>Sharing what I learn.</em></h1>
      <p class="lede">I’m Gabriel. I work across backend and frontend engineering, with a focus on APIs, reliability, and the decisions that make software easier to maintain. I’m also building iOS projects and writing about what I learn along the way.</p>
    </div>
    <aside class="hero-aside" aria-label="Current focus">
      <span class="aside-index">CURRENT FOCUS / 2026</span>
      <h2>From production systems to personal experiments</h2>
      <p>My work spans commerce platforms and distributed services. My current independent projects help me deepen my iOS and product skills.</p>
      <a class="text-link" href={urlFor('work/')}>Explore my work <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow">Selected work</span><h2 id="work-title">What I’ve worked on</h2></div><a class="text-link" href={urlFor('work/')}>All work <span aria-hidden="true">↗</span></a></div>
    <div class="work-grid">{projects.slice(0, 3).map((project) => <WorkCard project={project} />)}</div>
  </section>

  <section class="section" aria-labelledby="writing-title" style="margin-top: 7rem">
    <div class="section-heading"><div><span class="eyebrow">Writing</span><h2 id="writing-title">Notes from the journey</h2></div><a class="text-link" href={urlFor('blog/')}>All articles <span aria-hidden="true">↗</span></a></div>
    <div class="post-list">
      {posts.map((post) => <article class="post-row">
        <time datetime={post.data.published.toISOString()}>{publicationDate(post.data.published)}</time>
        <div><h3><a href={urlFor(`blog/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
        <span class="post-meta">{post.data.category} · {post.data.readingMinutes} min</span>
      </article>)}
    </div>
  </section>
</BaseLayout>
