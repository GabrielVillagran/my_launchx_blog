---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../lib/projects';
---
<BaseLayout title="Work" description="Selected professional experience and independent software projects by Gabriel Villagrán.">
  <header class="page-heading"><span class="eyebrow">Selected work</span><h1>Projects & practice.</h1><p>A mix of professional experience, academic research, and projects I’m building to keep learning. Each entry states its current scope.</p></header>
  {projects.map((project) => <section class="intro-panel section" aria-labelledby={`project-${project.number}`}>
    <div><span class="eyebrow">{project.number} / {project.category}</span><h2 id={`project-${project.number}`}>{project.title}</h2></div>
    <div><p>{project.detail}</p><div class="card-tags" style="margin: 1.5rem 0">{project.tags.map((tag) => <span>{tag}</span>)}</div><p style="font-size: .88rem">{project.note}</p>{'href' in project && project.href && <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">View repository ↗</a>}</div>
  </section>)}
</BaseLayout>
