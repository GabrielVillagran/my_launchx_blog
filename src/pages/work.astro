---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../lib/experience';
import { urlFor } from '../lib/site';
---
<BaseLayout title="Experience" description="Gabriel Villagrán's professional experience in software engineering, iOS development, and industrial systems.">
  <header class="page-heading"><span class="eyebrow">Professional experience</span><h1>Work, in context.</h1><p>From industrial monitoring to mobile commerce and API-driven products, here is what I contributed in each role.</p></header>
  {experience.map((position) => <section class="intro-panel section" aria-labelledby={`position-${position.number}`}>
    <div><span class="eyebrow">{position.period} · {position.location}</span><h2 id={`position-${position.number}`}>{position.company}</h2><p class="position-role">{position.role}</p></div>
    <div><p>{position.summary}</p><div class="card-tags" style="margin: 1.5rem 0">{position.tags.map((tag) => <span>{tag}</span>)}</div><a class="text-link" href={urlFor(`work/${position.slug}/`)}>Read about this role <span aria-hidden="true">↗</span></a></div>
  </section>)}
</BaseLayout>
