---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { publicationDate, urlFor } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description} pageType="article" published={post.data.published} revised={post.data.revised}>
  <article>
    <header class="article-head">
      <a class="eyebrow" href={urlFor('blog/')} style="text-decoration: none">Writing / {post.data.category}</a>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-meta"><span><time datetime={post.data.published.toISOString()}>{publicationDate(post.data.published)}</time></span><span>{post.data.readingMinutes} min read</span><span>Gabriel Villagrán</span></div>
    </header>
    <div class="content-layout">
      <div class="prose">
        {post.data.revised && <div class="revision-note">Originally published {publicationDate(post.data.published)} during my LaunchX learning journey. Revised {publicationDate(post.data.revised)} for clarity, accuracy, and current links.</div>}
        <Content />
        <div class="article-footer"><a class="text-link" href={urlFor('blog/')}>← Back to writing</a></div>
      </div>
      <aside><strong>From the archive</strong><p>These posts preserve their original publication dates. Revised text is marked above each article.</p></aside>
    </div>
  </article>
</BaseLayout>
