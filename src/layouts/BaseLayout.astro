---
import '../styles.css';
import { urlFor } from '../lib/site';

interface Props {
  title: string;
  description: string;
  pageType?: 'website' | 'article';
  published?: Date;
  revised?: Date;
}

const { title, description, pageType = 'website', published, revised } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title === 'Home' ? 'Gabriel Villagrán | Software Engineer' : `${title} | Gabriel Villagrán`;
const nav = [
  { name: 'Home', href: urlFor('') },
  { name: 'Work', href: urlFor('work/') },
  { name: 'Writing', href: urlFor('blog/') },
  { name: 'About', href: urlFor('about/') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1b29" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={urlFor('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {revised && <meta property="article:modified_time" content={revised.toISOString()} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={urlFor('')} aria-label="Gabriel Villagrán, home">
          <span class="brand-symbol" aria-hidden="true">G<span>.</span></span>
          <span>Gabriel Villagrán</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} aria-current={Astro.url.pathname === new URL(item.href, Astro.site).pathname ? 'page' : undefined}>{item.name}</a>
          ))}
        </nav>
        <a class="header-github" href="https://github.com/GabrielVillagran" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div>
          <strong>Gabriel Villagrán</strong>
          <span>Software engineering, writing, and the work in progress.</span>
        </div>
        <div class="footer-links">
          <a href={urlFor('blog/')}>Writing</a>
          <a href="https://github.com/GabrielVillagran" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={urlFor('about/')}>About</a>
        </div>
      </footer>
    </div>
  </body>
</html>
