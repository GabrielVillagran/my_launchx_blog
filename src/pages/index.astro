---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { experience } from '../lib/experience';
import { urlFor, publicationDate } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).slice(0, 3);
---
<BaseLayout title="Home" description="Gabriel Villagrán is a software engineer with experience in iOS, backend integrations, and industrial monitoring. Explore his work and writing.">
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <span class="eyebrow">Software engineer · Writer · Builder</span>
      <h1 id="hero-title">Building systems. <em>Sharing what I learn.</em></h1>
      <p class="lede">I’m Gabriel. I build iOS experiences, API integrations, and web interfaces. My work also includes industrial monitoring systems, and I write about what I learn along the way.</p>
    </div>
    <aside class="hero-aside" aria-label="Current focus">
      <span class="aside-index">CURRENT FOCUS / 2026</span>
      <h2>From industrial systems to mobile products</h2>
      <p>I’ve worked on airport monitoring, iOS commerce experiences, and products that connect mobile and web clients to backend APIs.</p>
      <a class="text-link" href={urlFor('work/')}>Explore my experience <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow">Professional experience</span><h2 id="work-title">What I’ve worked on</h2><p>A brief look at the roles and systems I’ve contributed to.</p></div><a class="text-link" href={urlFor('work/')}>All experience <span aria-hidden="true">↗</span></a></div>
    <div class="work-grid">{experience.map((position) => <WorkCard position={position} />)}</div>
  </section>

  <section class="section" aria-labelledby="writing-title" style="margin-top: 7rem">
    <div class="section-heading"><div><span class="eyebrow">Writing</span><h2 id="writing-title">Notes from the journey</h2></div><a class="text-link" href={urlFor('blog/')}>All articles <span aria-hidden="true">↗</span></a></div>
    <div class="post-list">
      {posts.map((post) => <article class="post-row">
        <time datetime={post.data.published.toISOString()}>{publicationDate(post.data.published)}</time>
        <div><h3><a href={urlFor(`blog/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
        <span class="post-meta">{post.data.category} · {post.data.readingMinutes} min</span>
      </article>)}
    </div>
  </section>
</BaseLayout>
